# Database
DATABASE_URL="postgresql://hubigo:hubigo@localhost:5432/hubigo?schema=public"

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET="change-me-in-production"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=""
NODE_ENV="development"

# Storage (local in development; S3-compatible in production)
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="hubigo"
S3_PUBLIC_URL=""
LOCAL_UPLOAD_DIR="public/uploads"

# Hostfully (https://api.hostfully.com)
HOSTFULLY_API_KEY=""
HOSTFULLY_API_BASE_URL="https://api.hostfully.com/v2"
HOSTFULLY_WEBHOOK_SECRET=""

# Web Push (https://vapidkeys.com/)
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:ops@hubigo.local"

# Optional One-Time Password / SMS (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
