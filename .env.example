# Database
DATABASE_URL="postgresql://hubigo:hubigo@localhost:5432/hubigo?schema=public"

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET="change-me-in-production"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=""
NODE_ENV="development"

# Storage (local in development; S3-compatible in production)
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="hubigo"
S3_PUBLIC_URL=""
# Local uploads dir: relative to project root in dev, /app/uploads in the prod container
LOCAL_UPLOAD_DIR="uploads"

# Production (docker-compose.prod.yml)
# Required: database password for the bundled postgres
POSTGRES_PASSWORD=""
# Host loopback port the app is published on (reverse proxy target)
APP_PORT="3100"
# Interface the app is published on. Keep loopback, or a docker bridge gateway
# (e.g. 172.20.0.1) when the reverse proxy itself runs in a container.
APP_BIND_ADDRESS="127.0.0.1"
# First admin account (used by: npm run db:create-admin)
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Hostfully API v3.3 (https://dev.hostfully.com)
# Sandbox base URL: https://sandbox-api.hostfully.com/api/v3.3
HOSTFULLY_API_KEY=""
HOSTFULLY_AGENCY_UID=""
HOSTFULLY_API_BASE_URL="https://api.hostfully.com/api/v3.3"
# Shared secret embedded in the webhook callback URL (?token=...)
HOSTFULLY_WEBHOOK_SECRET=""

# Web Push (https://vapidkeys.com/)
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT="mailto:ops@hubigo.local"

# Optional One-Time Password / SMS (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
